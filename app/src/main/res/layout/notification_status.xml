<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded pet status panel. RemoteViews only supports a fixed set of views (no Compose), so this
  is plain FrameLayout / LinearLayout / ImageView / TextView / Chronometer.

  The health bar is its own ImageView inside the text column, not painted onto the backdrop:
  the backdrop is scaled to whatever size the shade gives it, so anything drawn on it at fixed
  coordinates ends up colliding with the independently laid-out text.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/pet_face"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:id="@+id/pet_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#3D2E4E"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="5dp">

                <ImageView
                    android:id="@+id/health_bar"
                    android:layout_width="0dp"
                    android:layout_height="7dp"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/health_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#6B5B7B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/next_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="#3D2E4E"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8607E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timer_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B5B7B"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
