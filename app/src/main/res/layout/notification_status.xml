<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom RemoteViews layout for the ongoing pet status panel in the notification shade.
  RemoteViews only supports a fixed set of views (no Compose), so this is plain FrameLayout /
  LinearLayout / ImageView / TextView / Chronometer. The seasonal blurred backdrop and the
  health bar are drawn into a single bitmap at runtime and set on @id/bg, which sidesteps
  RemoteViews' inability to dynamically tint or resize child views.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/pet_face"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3D2E4E"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/health_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B5B7B"
                android:textSize="11sp"
                android:layout_marginTop="1dp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/next_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#3D2E4E"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="8dp">

            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8607E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timer_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#6B5B7B"
                android:textSize="10sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
