<?xml version="1.0" encoding="utf-8"?>
<!--
  Expanded pet status panel: a mini version of the in-app game HUD. RemoteViews only supports a
  fixed set of views (no Compose), so this is FrameLayout / LinearLayout / ImageView / TextView /
  Chronometer, with bitmaps (backdrop, portrait, bars) rendered in StatusNotification.

  Bars and the portrait are separate ImageViews rather than painted onto the backdrop: the backdrop
  is scaled to whatever size the shade gives it, so fixed-coordinate drawings would drift off the text.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="128dp">

    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/pet_face"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:contentDescription="@null" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/pet_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/mood_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/notif_pill"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="1dp"
                        android:paddingBottom="1dp"
                        android:textColor="#FFFFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="❤"
                        android:textColor="#FFFF8FA3"
                        android:textSize="11sp" />

                    <ImageView
                        android:id="@+id/health_bar"
                        android:layout_width="0dp"
                        android:layout_height="7dp"
                        android:layout_weight="1"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/health_label"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="#F2FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="16dp"
                        android:layout_height="wrap_content"
                        android:text="★"
                        android:textColor="#FFFFD166"
                        android:textSize="11sp" />

                    <ImageView
                        android:id="@+id/xp_bar"
                        android:layout_width="0dp"
                        android:layout_height="7dp"
                        android:layout_weight="1"
                        android:scaleType="fitXY"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/xp_label"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:textColor="#F2FFFFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:maxLines="1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Next habit strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@drawable/notif_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timer_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#CCFFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/next_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <Chronometer
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/notif_timer_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="#FF7A4E9C"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
